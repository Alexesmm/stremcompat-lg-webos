{
  "name": "stremcompat-lg-webos",
  "version": "1.1.2",
  "private": true,
  "description": "Stremio community compatibility ports for legacy LG webOS 3.x and 4.x televisions",
  "scripts": {
    "runtime": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-runtime.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile um4-armv7 -SkipPackage",
    "build:uj3": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-armv7 -SkipPackage",
    "build:uj3-native": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-native-armv7 -SkipPackage",
    "build:um4-hd": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile um4-armv7-hd -SkipPackage",
    "build:uj3-native-hd": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-native-armv7-hd -SkipPackage",
    "package": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile um4-armv7",
    "package:um4": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile um4-armv7",
    "package:uj3": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-armv7",
    "package:uj3-native": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-native-armv7",
    "package:um4-hd": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile um4-armv7-hd",
    "package:uj3-native-hd": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile uj3-native-armv7-hd",
    "package:all": "npm run package:um4 && npm run package:um4-hd && npm run package:uj3-native && npm run package:uj3-native-hd",
    "test": "node ./scripts/selftest-frontend.js && node ./scripts/selftest-runtime.js",
    "test:chrome38": "node ./scripts/selftest-chromium38.js",
    "test:visual:layouts": "powershell -ExecutionPolicy Bypass -File ./scripts/visualtest-layouts.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify.ps1"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "acorn": "8.15.0",
    "esbuild": "0.25.10"
  }
}
