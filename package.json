{
  "name": "stremcompat-lg-webos",
  "version": "4.2.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Stremio community compatibility ports for legacy LG webOS 3.x and 4.x televisions",
  "scripts": {
    "build:ui": "node ./scripts/build-ui.js",
    "lint": "eslint service scripts platforms eslint.config.js",
    "build:tizen": "node ./scripts/build-ui.js && node ./scripts/build-tizen.js",
    "package:tizen": "powershell -ExecutionPolicy Bypass -File ./scripts/package-tizen.ps1",
    "package:android": "node ./scripts/package-android.js",
    "format": "prettier --write \"src/ui/**/*.js\" \"src/player/*.js\" \"src/platform/**/*.js\" \"platforms/tizen/*.js\" \"platforms/tizen/service/*.js\" \"service/local-server.js\" \"service/server/*.js\"",
    "format:check": "prettier --check \"src/ui/**/*.js\" \"src/player/*.js\" \"src/platform/**/*.js\" \"platforms/tizen/*.js\" \"platforms/tizen/service/*.js\" \"service/local-server.js\" \"service/server/*.js\"",
    "runtime": "powershell -ExecutionPolicy Bypass -File ./scripts/fetch-runtime.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile lg-armv7 -SkipPackage",
    "package": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile lg-armv7-1080",
    "package:all": "npm run package && npm run package:1080",
    "test": "node ./scripts/selftest-frontend.js && node ./scripts/selftest-player.js && node ./scripts/selftest-runtime.js && node ./scripts/selftest-tizen.js",
    "test:chrome38": "node ./scripts/selftest-chromium38.js",
    "test:visual:layouts": "powershell -ExecutionPolicy Bypass -File ./scripts/visualtest-layouts.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify.ps1",
    "package:720": "powershell -ExecutionPolicy Bypass -File ./scripts/build.ps1 -Profile lg-armv7"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "acorn": "8.15.0",
    "esbuild": "0.25.10",
    "eslint": "9.12.0",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "webtorrent": "1.9.7"
  }
}
